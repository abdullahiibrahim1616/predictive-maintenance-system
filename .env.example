POSTGRES_DB=predictive_maintenance
POSTGRES_USER=predmaint

# These are paths to local secret files; do not put secret values in this file.
POSTGRES_PASSWORD_FILE=.secrets/postgres_password
JWT_SECRET_FILE=.secrets/jwt_secret
BOOTSTRAP_ADMIN_PASSWORD_FILE=.secrets/bootstrap_admin_password
RBAC_JWT_SECRET_FILE=.secrets/rbac_jwt_secret
RBAC_BOOTSTRAP_PASSWORD_FILE=.secrets/rbac_bootstrap_password
BOOTSTRAP_ADMIN_EMAIL=admin@localhost.test
RBAC_BOOTSTRAP_ADMIN_EMAIL=rbac-admin@localhost.test
DEMO_PASSWORD=ChangeMe!2026
DEMO_ADMIN_EMAIL=admin@localhost.test
DEMO_MAINTENANCE_EMAIL=maint.mgr@localhost.test
DEMO_OPERATIONS_EMAIL=ops.mgr@localhost.test
DEMO_TECHNICIAN_EMAIL=tech.field@localhost.test

# Public browser origins/ports for local deployment. Set the origins to your HTTPS URLs in production.
APP_ORIGIN=http://localhost:3000
RBAC_APP_ORIGIN=http://localhost:3001
APP_BIND_ADDRESS=127.0.0.1
RBAC_APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
RBAC_APP_PORT=3001

# Optional AWS integrations. The backend uses the AWS SDK default credential chain;
# use an IAM role in AWS rather than storing access keys here.
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_PREFIX=telemetry
AWS_SNS_ENABLED=false
AWS_SNS_TOPIC_ARN=
AWS_SNS_SMS_PHONE=
AWS_KMS_KEY_ID=
MAINTENANCE_ALERT_EMAIL=
